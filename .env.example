# ============================================================
# Agentic CRM -- environment variables
# Copy to .env and fill in real values before running.
# ============================================================

# App
APP_ENV=dev                        # dev | staging | prod

# ERPNext
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here
ERPNEXT_COMPANY=DEWMIX Hardware
ERPNEXT_DEFAULT_WAREHOUSE=Stores - DX
ERPNEXT_PRICE_LIST=Standard Selling
ERPNEXT_SALES_TAXES_TEMPLATE=Kenya VAT 16% - DX
ERPNEXT_WEBHOOK_SECRET=

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Redis
REDIS_URL=redis://localhost:6379/0

# NIM / LLM
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# WhatsApp
# DEWMIX Hardware WhatsApp: +254 787 151 516
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
BUSINESS_WHATSAPP_NUMBER=254787151516

# M-Pesa Daraja (Phase 2)
# Sandbox credentials from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Base callback URL -- invoice name is appended: {MPESA_CALLBACK_URL}/{invoice_name}
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox
# ERPNext Mode of Payment name (must exist in ERPNext)
MPESA_MODE_OF_PAYMENT=Cash
# Optional account overrides (leave empty to use ERPNext defaults from Mode of Payment)
MPESA_DEBTORS_ACCOUNT=
MPESA_PAID_TO_ACCOUNT=

# Sentry
SENTRY_DSN=

# Feature flags
FEATURE_WEBSITE_BUY=false
FEATURE_EXTRA_CHANNELS=false
