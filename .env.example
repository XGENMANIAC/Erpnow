# ============================================================
# Agentic CRM — Phase 1 environment variables
# Copy to .env and fill in real values before running.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=dev                        # dev | staging | prod

# ── ERPNext ──────────────────────────────────────────────────
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here
ERPNEXT_COMPANY=DEWMIX Hardware
ERPNEXT_DEFAULT_WAREHOUSE=Stores - DX
ERPNEXT_PRICE_LIST=Standard Selling
ERPNEXT_WEBHOOK_SECRET=

# ── Database (PostgreSQL for integration service) ────────────
DATABASE_URL=postgresql+asyncpg://crm:crm@db:5432/crm

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── NIM / LLM ────────────────────────────────────────────────
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# ── WhatsApp / Channels ──────────────────────────────────────
# DEWMIX Hardware WhatsApp line: +254 787 151 516
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
BUSINESS_WHATSAPP_NUMBER=254787151516

# ── M-Pesa (Phase 2) ─────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=

# ── Feature flags ────────────────────────────────────────────
FEATURE_WEBSITE_BUY=false
FEATURE_EXTRA_CHANNELS=false
